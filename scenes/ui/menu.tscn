[node name="Label" type="Label" parent="HowTo/TextBG" unique_id=2071235110]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 24
text = "Welcome to one short day in the life of Jo, a perfectly average person working as an analyst at a perfectly average company. Over the course of three phases you'll decide what Jo does with her time by selecting tasks for her to complete. Hover over tasks to see a short description, and click on tasks to complete them, but be careful what you prioritize! Jo only has a set amount of time in her day, which you can see counting down in the top left corner of the screen. It is up to you what her day looks like - will you conquer the office and end the day triumphant, or will you crash and burn in poor Jo's shoes?"
autowrap_mode = 2

